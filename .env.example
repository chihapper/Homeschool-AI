# ---- Required for everything (curriculum ingest, text tutor, assessment) ----
ANTHROPIC_API_KEY=sk-ant-...

# Models. claude-opus-5 is the code default for every agent (curriculum, profile, assessment).
# The live voice tutor is the exception: published time-to-first-token is roughly 2.7 s for Opus 5 at low
# effort, ~0.8-1.4 s for Sonnet 5, ~0.6-0.7 s for Haiku 4.5 (see docs/LATENCY.md). Sonnet 5 is the
# recommended voice tier; measure with `npm run chat` and change if you prefer Opus quality over speed.
CLAUDE_MODEL=claude-opus-5
CLAUDE_TUTOR_MODEL=claude-sonnet-5
CLAUDE_TUTOR_EFFORT=low
CLAUDE_ANALYSIS_EFFORT=high
# Live tutor thinking: adaptive (default) or disabled. See docs/LATENCY.md before changing.
CLAUDE_TUTOR_THINKING=adaptive
# Pre-warm the tutor prompt cache when a session starts (one cache write, faster first turn).
CLAUDE_PREWARM_CACHE=true
# Route safety-classifier refusals to a fallback model automatically (server-side fallbacks beta).
CLAUDE_REFUSAL_FALLBACKS=true

# ---- Media ingestion (videos, podcasts). Optional. ----
# yt-dlp handles YouTube, TED, Vimeo and most video/audio sites: pip install yt-dlp
YTDLP_BIN=yt-dlp
# Speech-to-text for recordings without captions: deepgram | whisper-cli | none
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
WHISPER_BIN=whisper

# ---- Voice in the browser: the student talks, the tutor talks back. No tunnel needed. ----
# Speech-to-text: AssemblyAI Universal Streaming (end-of-turn detection). Free key at assemblyai.com.
ASSEMBLYAI_API_KEY=
VOICE_STT=assemblyai
# ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
# End of the student's turn: silence (ms) that ends it when the sentence sounds complete / no matter what.
ASSEMBLYAI_MIN_TURN_SILENCE=400
ASSEMBLYAI_MAX_TURN_SILENCE=1500
# Text-to-speech: who voices the tutor, hume (Octave, uses HUME_API_KEY below) or elevenlabs. This is only the
# default: the toggle at the top of Settings > Voice switches it at runtime, from the next reply.
VOICE_TTS=hume
# Hume Octave: Voice Library name, or CUSTOM_VOICE:<id>.
HUME_TTS_VOICE=Ava Song
HUME_TTS_VERSION=2
HUME_TTS_INSTANT=true
# Send the sentences already written as one request so the voice keeps its cadence across them (both providers; Settings can toggle).
HUME_TTS_BATCH=true
# ElevenLabs: the key itself, which starts with sk_ and is shown once when created or rotated. The dashboard
# also lists a key ID beside it; that ID does not authenticate (HTTP 400 "API key ID used as API key").
ELEVENLABS_API_KEY=
# Defaults for Settings > Voice; the voice and model pickers there list what your account has.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_NAME=George
# eleven_flash_v2_5 (fastest, ~75 ms), eleven_v3_conversational (expressive, ~280 ms, same credits), eleven_multilingual_v2 (double the credits)
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SPEED=1

# ---- Voice via Hume EVI (alternative speech-to-speech path; needs a public URL). ----
HUME_API_KEY=
HUME_SECRET_KEY=
# Created by `npm run setup:hume` once PUBLIC_URL is set.
HUME_CONFIG_ID=
# Public HTTPS base URL of this server as Hume can reach it (e.g. an ngrok tunnel during development).
PUBLIC_URL=
# Shared secret Hume must send as `Authorization: Bearer ...` to the CLM endpoint. Any long random string.
CLM_SECRET=

# ---- Server ----
PORT=3001
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
LOG_LEVEL=info
