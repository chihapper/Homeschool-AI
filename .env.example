# ---- Required for everything (curriculum ingest, text tutor, assessment) ----
ANTHROPIC_API_KEY=sk-ant-...

# Models. claude-opus-5-5 is the code default for the offline agents (curriculum, profile, assessment) and
# claude-sonnet-5-5 for the live tutor, whose first word has to come fast: Sonnet 5.5 can run with no
# thinking before it speaks, Opus 5.5 always thinks a little (see docs/LATENCY.md). IDs use hyphens, never
# dots ("claude-sonnet-5.5" is a 404); what each model accepts is one table in apps/server/src/llm/models.ts.
# Measure with `npm run chat` and change if you prefer Opus quality over speed.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TUTOR_MODEL=claude-sonnet-5-5
CLAUDE_TUTOR_EFFORT=low
CLAUDE_ANALYSIS_EFFORT=high
# Live tutor thinking: adaptive (default) or disabled. See docs/LATENCY.md before changing.
CLAUDE_TUTOR_THINKING=adaptive
# Pre-warm the tutor prompt cache when a session starts (one cache write, faster first turn).
CLAUDE_PREWARM_CACHE=true
# Route safety-classifier refusals to a fallback model automatically (server-side fallbacks beta).
CLAUDE_REFUSAL_FALLBACKS=true

# ---- Facts from outside the family's material ----
# check (answer, then check the fact against Wikipedia in the background), answer (no check), or material-only.
# Settings > Outside the reading overrides it; a session keeps the setting it started with.
# OUTSIDE_KNOWLEDGE=check
# An email address or website Wikimedia can reach. Its policy requires one in every request, and an anonymous
# program is limited to 10 requests a minute. Without it nothing is checked. It need not describe this app.
WIKIPEDIA_CONTACT=

# ---- Media ingestion (videos, podcasts). Optional. ----
# yt-dlp handles YouTube, TED, Vimeo and most video/audio sites: pip install yt-dlp
YTDLP_BIN=yt-dlp
# Speech-to-text for recordings without captions: deepgram | whisper-cli | none
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
WHISPER_BIN=whisper

# ---- Voice in the browser: the student talks, the tutor talks back. No tunnel needed. ----
# Speech-to-text: AssemblyAI Universal Streaming (end-of-turn detection). Free key at assemblyai.com.
ASSEMBLYAI_API_KEY=
VOICE_STT=assemblyai
# ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
# End of the student's turn: silence (ms) that ends it when the sentence sounds complete / no matter what.
ASSEMBLYAI_MIN_TURN_SILENCE=400
ASSEMBLYAI_MAX_TURN_SILENCE=1500
# Text-to-speech: who voices the tutor, inworld or elevenlabs. This is only the default: the toggle at the top
# of Settings > Voice switches it at runtime, from the next reply.
VOICE_TTS=inworld
# Send the sentences already written as one request so the voice keeps its cadence across them (Settings can toggle).
VOICE_TTS_BATCH=true
# ElevenLabs: the key itself, which starts with sk_ and is shown once when created or rotated. The dashboard
# also lists a key ID beside it; that ID does not authenticate (HTTP 400 "API key ID used as API key").
ELEVENLABS_API_KEY=
# Defaults for Settings > Voice; the voice and model pickers there list what your account has.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_NAME=George
# eleven_flash_v2_5 (fastest, ~75 ms), eleven_v3_conversational (expressive, ~280 ms, same credits), eleven_multilingual_v2 (double the credits)
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SPEED=1
# Inworld: the Base64 credential from the Portal's API keys page (its Base64 copy button), pasted as-is:
# no "Basic " in front, not encoded again, and not the key ID alone. A reply is voiced as one stream per reply.
INWORLD_API_KEY=
# Defaults for Settings > Voice; the voice picker there lists the workspace's English voices.
# INWORLD_VOICE_ID=Ashley
# INWORLD_VOICE_NAME=Ashley
# inworld-tts-2 (most natural, ~100 ms) or inworld-tts-2-flash (fastest and cheapest, ~20 ms)
# INWORLD_MODEL=inworld-tts-2
# INWORLD_SPEED=1
# Pause, in ms, added after a sentence ending in a full stop; a comma gets less, a question more, a paragraph most.
# INWORLD_PAUSE_MS=220

# ---- Server ----
PORT=3001
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
LOG_LEVEL=info
