# ---- Required for everything (curriculum ingest, text tutor, assessment) ----
ANTHROPIC_API_KEY=sk-ant-...

# Models. claude-opus-5 is the code default for every agent (curriculum, profile, assessment).
# The live voice tutor is the exception: published time-to-first-token is roughly 2.7 s for Opus 5 at low
# effort, ~0.8-1.4 s for Sonnet 5, ~0.6-0.7 s for Haiku 4.5 (see docs/LATENCY.md). Sonnet 5 is the
# recommended voice tier; measure with `npm run chat` and change if you prefer Opus quality over speed.
CLAUDE_MODEL=claude-opus-5
CLAUDE_TUTOR_MODEL=claude-sonnet-5
CLAUDE_TUTOR_EFFORT=low
CLAUDE_ANALYSIS_EFFORT=high
# Live tutor thinking: adaptive (default) or disabled. See docs/LATENCY.md before changing.
CLAUDE_TUTOR_THINKING=adaptive
# Pre-warm the tutor prompt cache when a session starts (one cache write, faster first turn).
CLAUDE_PREWARM_CACHE=true
# Route safety-classifier refusals to a fallback model automatically (server-side fallbacks beta).
CLAUDE_REFUSAL_FALLBACKS=true

# ---- Media ingestion (videos, podcasts). Optional. ----
# yt-dlp handles YouTube, TED, Vimeo and most video/audio sites: pip install yt-dlp
YTDLP_BIN=yt-dlp
# Speech-to-text for recordings without captions: deepgram | whisper-cli | none
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
WHISPER_BIN=whisper

# ---- Voice (Hume EVI). Optional: without these, the app runs in text mode. ----
HUME_API_KEY=
HUME_SECRET_KEY=
# Created by `npm run setup:hume` once PUBLIC_URL is set.
HUME_CONFIG_ID=
# Public HTTPS base URL of this server as Hume can reach it (e.g. an ngrok tunnel during development).
PUBLIC_URL=
# Shared secret Hume must send as `Authorization: Bearer ...` to the CLM endpoint. Any long random string.
CLM_SECRET=

# ---- Server ----
PORT=3001
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
LOG_LEVEL=info
